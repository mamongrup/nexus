APP_ENV=development
APP_PORT=8081
APP_ORIGIN=http://127.0.0.1:8081
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=nexustraveltech
PGUSER=nexus_app
PGPASSWORD=generated-by-setup
PGOWNER=nexus_owner
PGOWNER_PASSWORD=generated-by-setup
SECRET_KEY_BASE=generated-by-setup
ADMIN_EMAIL=admin@nexus.local
ADMIN_PASSWORD=generated-by-setup
# Operational alarm channels. Read by scripts/auth-session-expiry-worker.ps1
# (worker alert layer; pattern: scripts/notify-rotation-overdue.ps1) and by the
# weekly rotation check. Both channels are optional and independent: a broken
# channel never stops the worker, it only logs. Leave empty to keep the
# log-only behaviour (no delivery, no behaviour change).
# Slack compatible POST target receiving {"text": "..."}.
ALERT_WEBHOOK_URL=
# Recipients for Send-MailMessage alerts. SMTP settings are shared with the
# rotation check: MAIL_HOST, MAIL_PORT (default 587), MAIL_FROM, MAIL_USER,
# MAIL_PASSWORD. ALERT_MAIL_FROM overrides MAIL_FROM for alerts only.
ALERT_MAIL_TO=
ALERT_MAIL_FROM=
# Minimum minutes between two alerts for the same fault (default 60).
# Set to 0 to alert on every qualifying failure.
ALERT_COOLDOWN_MINUTES=60
# NEXUS_API_KEY authenticates platform level agency API calls. It is a
# credential only: never reuse NEXUS_CONFIG_KEY for authentication, because
# that key protects every sealed setting at rest.
NEXUS_API_KEY=generated-by-setup
# Comma separated addresses or CIDR blocks of reverse proxies allowed to set
# X-Forwarded-For / CF-Connecting-IP. Leave empty to ignore those headers
# entirely and rate limit on the socket peer address.
TRUSTED_PROXY_CIDRS=
# NEXUS_CONFIG_KEY is generated by scripts/config-key.ps1; keep its backup separate.
# APP_PUBLIC_HOST is required only when APP_ENV=production and is read from
# .env.production.example.
# ParamPOS, AI and integration credentials are entered in /admin/settings.
