# Copy to .env on the server and replace every CHANGE_ME value. Never package .env.
APP_ENV=production
APP_PORT=8081
APP_ORIGIN=https://nexus.example.com
APP_PUBLIC_HOST=nexus.example.com
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nexustraveltech
PGUSER=nexus_app
PGPASSWORD=CHANGE_ME_RUNTIME_DB_PASSWORD
PGOWNER=nexus_owner
PGOWNER_PASSWORD=CHANGE_ME_MIGRATION_DB_PASSWORD
SECRET_KEY_BASE=CHANGE_ME_64_RANDOM_CHARACTERS
NEXUS_CONFIG_KEY=CHANGE_ME_64_RANDOM_CHARACTERS_KEEP_STABLE
# Credential for platform level agency API calls. Keep it separate from
# NEXUS_CONFIG_KEY, which is the encryption key for sealed settings.
NEXUS_API_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
# Reverse proxies allowed to set X-Forwarded-For / CF-Connecting-IP. Leave
# empty unless a proxy really sits in front of this process; any value here
# lets the listed proxy assert the client address used for rate limiting.
TRUSTED_PROXY_CIDRS=
